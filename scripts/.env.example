# 图标仓账号配置 · 复制为 .env 后修改，部署时把它放到 dist/.env
# 改完不需要重新 build，直接改服务器上的 dist/.env 即可
ADMIN_USER=admin
ADMIN_PASS=change-me

USER_USER=guest
USER_PASS=change-me

# 会话签名 + 偏好密文的密钥，务必换成一段随机字符串
SESSION_SECRET=please-change-to-a-long-random-string

# 登录有效期（秒）
TOKEN_TTL=86400

# 给 AI 用的管理员 key：请求带 X-Icon-Key 头（或 ?key=）时按管理员处理
# 留空则关闭这个入口
ADMIN_AI_KEY=

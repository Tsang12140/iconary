{
  "name": "icon-library",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "16 分类 · 548 枚精选 SVG 图标，源文件抽取自 lucide-static，含元数据、检索与可视化选型页",
  "exports": {
    ".": "./library/index.mjs",
    "./icons.json": "./data/icons.json",
    "./sprite.svg": "./icons/sprite.svg",
    "./css": "./library/icon.css"
  },
  "scripts": {
    "build": "node src/build.mjs",
    "validate": "node src/validate.mjs",
    "all": "npm run build && npm run validate"
  },
  "keywords": [
    "icons",
    "svg",
    "lucide",
    "icon-library"
  ],
  "license": "ISC",
  "dependencies": {
    "lucide-static": "^1.67.0"
  }
}
